# Copy this file to .env.share, set permissions to 600, and fill in secrets.
# Never commit .env.share. Docker Compose injects these values at runtime only.

# Whole-site access protection. Set a private password of at least 12 characters.
# This is one shared team account, not per-user permissions.
PRONOIA_SHARE_USER=pronoia
PRONOIA_SHARE_PASSWORD=


# reverse proxy; change it only when the surrounding network is trusted.
PORT=8000
PRONOIA_HOST_PORT=8000
PRONOIA_BIND_ADDRESS=127.0.0.1

# Model API for the built-in platform Agent (for example, OpenAI, DeepSeek, or Volcengine Ark)
LLM_API_URL=
LLM_API_KEY=


# Optional higher-priority compatible model endpoint. Leave all three blank to
# use the LLM settings above.
MAAS_API_URL=
MAAS_API_KEY=


# Optional credentials for user-managed connectors. The UI references these as
# env:PRONOIA_STRATEGY_SECRET_* / PRONOIA_DATA_SECRET_*; it can never borrow the
# platform model key or sharing password.
# PRONOIA_STRATEGY_SECRET_MY_MODEL=
# PRONOIA_DATA_SECRET_MY_VENDOR=

# Optional comma-separated browser origins for a separately hosted frontend.
# The all-in-one image is same-origin and normally does not need this setting.
PRONOIA_CORS_ORIGINS=

# Keep private/localhost external model endpoints disabled on shared servers.
PRONOIA_ALLOW_PRIVATE_MODEL_ENDPOINTS=0

# Runtime limits
PRONOIA_SKILL_TIMEOUT=60
PRONOIA_TOOL_RESULT_MAX_CHARS=4000
PRONOIA_AUTO_MAX_ROUNDS=8
PRONOIA_TEAM_MAX_ROUNDS=5
PRONOIA_CONTEXT_MESSAGES=12
PRONOIA_LLM_TIMEOUT=180
