# Ark LLM (OpenAI 兼容接口，可换成任意 OpenAI 兼容端点)
ARK_API_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_API_KEY=your-api-key-here
ARK_MODEL=deepseek-v4-flash

# 某些本地网络环境下 Python/httpx 的默认 TLS 路径会超时；需要时强制 IPv4。
FEVER_LLM_FORCE_IPV4=0

# Skill 超时分层：顶层 / 普通原子子技能 / 慢速子技能 / 嵌套组合技能。
# 子技能预算必须短于父技能，避免父子同时在 60s 到期而丢失部分成功结果。
FEVER_SKILL_TIMEOUT=60
FEVER_SKILL_SUB_TIMEOUT=30
FEVER_SKILL_SLOW_SUB_TIMEOUT=45
FEVER_SKILL_COMPOSITE_SUB_TIMEOUT=50

# Evidence Navigator：图谱完成后最多做一次有预算的定向补证。
# 设为 0 可退回原有的 plan → expert → synthesize 流程。
FEVER_EVIDENCE_NAVIGATOR=1
FEVER_EVIDENCE_NAVIGATOR_MAX_ROUNDS=1
FEVER_EVIDENCE_NAVIGATOR_MAX_DISPATCHES=1
FEVER_EVIDENCE_NAVIGATOR_EXTERNAL_SKILL_BUDGET=1

# 独立异步推演网关；quick 模式通常需要数分钟，不能占用普通 skill 请求。
FEVER_SIMULATION_GATEWAY_URL=http://127.0.0.1:5010
FEVER_SIMULATION_GATEWAY_TIMEOUT=15

# 可选：外部策略/数据 API 的密钥必须使用专用前缀，不能引用 ARK_API_KEY。
# PRONOIA_STRATEGY_SECRET_MY_MODEL=
# PRONOIA_DATA_SECRET_MY_VENDOR=
